# Supabase 프로젝트 설정 → API 에서 복사
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용 (본인인증 결과 저장, 프로필 생성). 절대 NEXT_PUBLIC_ 붙이지 말 것
SUPABASE_SERVICE_ROLE_KEY=

# 학교 메일 도메인 (확인 후 수정)
NEXT_PUBLIC_SCHOOL_EMAIL_DOMAIN=bu.ac.kr

# 포트원 통합 본인인증 (KG이니시스) — 연동 시 사용
NEXT_PUBLIC_PORTONE_STORE_ID=
NEXT_PUBLIC_PORTONE_CHANNEL_KEY=
PORTONE_API_SECRET=

# 개발용
# 본인인증을 포트원 없이 테스트 (서버/화면 둘 다 1일 때 "만 19세 이상/미만 결과" 버튼 표시). 운영에서는 반드시 비움
IDENTITY_MOCK=
NEXT_PUBLIC_IDENTITY_MOCK=
# 배포 환경에서 /preview/01~46 디자인 확인 화면 열기 (개발 모드는 항상 열림)
ENABLE_PREVIEW=
