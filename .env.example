# Supabase 프로젝트 설정 → API 에서 복사
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용 (본인인증 결과 저장, 프로필 생성). 절대 NEXT_PUBLIC_ 붙이지 말 것
SUPABASE_SERVICE_ROLE_KEY=

# 학교 메일 도메인 (확인 후 수정)
NEXT_PUBLIC_SCHOOL_EMAIL_DOMAIN=bu.ac.kr

# 포트원 통합 본인인증 (KG이니시스) — 연동 시 사용
NEXT_PUBLIC_PORTONE_STORE_ID=
NEXT_PUBLIC_PORTONE_CHANNEL_KEY=
PORTONE_API_SECRET=

# 정오 매칭 알림 (Web Push). 키 만들기: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# 푸시 서비스에 알리는 연락처 (mailto:주소)
VAPID_SUBJECT=
# DB pg_cron이 /api/push/noon 을 부를 때 쓰는 비밀값. Vault 'push_cron_secret'과 같게 (openssl rand -hex 32)
PUSH_CRON_SECRET=

# 약관·처리방침에 보일 문의 메일 (비워두면 "앱 공지사항"으로 안내)
NEXT_PUBLIC_SUPPORT_EMAIL=
# 카카오톡 채널 1:1 문의 주소 (예: https://pf.kakao.com/_xxxx/chat)
NEXT_PUBLIC_KAKAO_CHANNEL_URL=

# 개발용
# 배포 환경에서 /preview/01~46 디자인 확인 화면 열기 (개발 모드는 항상 열림)
ENABLE_PREVIEW=
